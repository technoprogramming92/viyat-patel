---
// src/components/GalleryComponent.astro
// Import the JSON data generated by our script
import galleryImages from '../../../data/galleryImages.json';

// Define an interface for better type safety and autocompletion in your editor
interface GalleryImage {
  id: string;
  name: string;
  title: string;
  category: string;
  thumbnail: string; // URL for the thumbnail image
  fullSize: string;  // URL for the full-size image (for lightbox)
}

// You can optionally sort your images here if needed
// const sortedImages = galleryImages.sort((a, b) => a.title.localeCompare(b.title));
---

<section class="section-padding2">
    <div class="container">
        <div class="row">
            <!-- <div class="col-md-12">
                <h2 class="section-title"><span>Gallery</span></h2>
            </div>
        </div>
        <div class="row justify-content-start">
            <div class="col-lg-10 col-md-12">
                <p>Gallery lorem ac erat suscipit bibendum. Nulla facilisi. Sedeuter nunc volutpat, mollis sapien vel, conseyer turpeutionyer masin libero sempe. Fusceler mollis augue sit amet hendrerit vestibulum. Duisteyerionyer venenatis lacus.</p>
            </div>
        </div> -->

        <div class="row">
            {galleryImages.map((image: GalleryImage) => (
                <div class="col-12 col-sm-6 col-md-6 col-lg-4 gallery-item">
                    <a href={image.fullSize} title={image.title} class="img-zoom">
                        <div class="gallery-box">
                            <div class="gallery-img">
                                <img src={image.fullSize} class="img-fluid mx-auto d-block" alt={image.title}>
                            </div>
                            </div>
                    </a>
                </div>
            ))}
        </div>
    </div>
</section>