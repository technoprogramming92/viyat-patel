---
// src/components/GalleryComponent.astro
// Import the JSON data generated by our script
import galleryImages from '../../data/galleryImages.json';

// Define an interface for better type safety and autocompletion in your editor
interface GalleryImage {
  id: string;
  name: string;
  title: string;
  category: string;
  thumbnail: string; // URL for the thumbnail image
  fullSize: string;  // URL for the full-size image (for lightbox)
}

// You can optionally sort your images here if needed
// const sortedImages = galleryImages.sort((a, b) => a.title.localeCompare(b.title));
---

<head>
  <link href="gallery-css/style.css" rel="stylesheet" media="screen">
  </head>

<main class="main main-inner main-projects bg-projects" data-stellar-background-ratio="0.6">
  <div class="container">
    <header class="main-header">
      <h1>Projects</h1>
    </header>
  </div>

  <div class="page-lines">
    <div class="container">
      <div class="col-line col-xs-4"><div class="line"></div></div>
      <div class="col-line col-xs-4"><div class="line"></div></div>
      <div class="col-line col-xs-4"><div class="line"></div><div class="line"></div></div>
    </div>
  </div>
</main>

<div class="layout">
  <div class="page-lines">
    <div class="container">
      <div class="col-line col-xs-4"><div class="line"></div></div>
      <div class="col-line col-xs-4"><div class="line"></div></div>
      <div class="col-line col-xs-4"><div class="line"></div><div class="line"></div></div>
    </div>
  </div>

  <div class="content">
    <section class="projects">
      <div class="js-projects-gallery">
        <div class="row">
          {galleryImages.map((image: GalleryImage) => (
            <div class="project col-sm-6 col-md-4 col-lg-3">
              {/* The 'href' for the full-size image, 'title' for the lightbox caption */}
              <a href={image.fullSize} title={image.title}>
                <figure>
                  {/* The 'src' for the thumbnail, 'alt' for accessibility */}
                  <img alt={image.title} src={image.fullSize}>
                  <figcaption>
                    <h3 class="project-title">
                      {image.title.split('<br>').map((line, index) => (
                        <Fragment key={index}>
                          {line}
                          {index < image.title.split('<br>').length - 1 && <br />}
                        </Fragment>
                      ))}
                    </h3>
                  {/* <h4 class="project-category">
                      {image.category}
                    </h4> */}  
                    <div class="project-zoom"></div>
                  </figcaption>
                </figure>
              </a>
            </div>
          ))}
        </div>
      </div>
      </section>
  </div>
</div>

<script is:inline src="gallery-js/jquery.min.js"></script>
<script is:inline src="gallery-js/bootstrap.min.js"></script>
<script is:inline src="gallery-js/smoothscroll.js"></script>
<script is:inline src="gallery-js/jquery.validate.min.js"></script>
<script is:inline src="gallery-js/wow.min.js"></script>
<script is:inline src="gallery-js/jquery.stellar.min.js"></script>
<script is:inline src="gallery-js/jquery.magnific-popup.js"></script>
<script is:inline src="gallery-js/owl.carousel.min.js"></script>
<script is:inline src="gallery-js/interface.js"></script>